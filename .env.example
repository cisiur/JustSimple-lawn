# ─────────────────────────────────────────────────────────────────────────────
# JustSimple Lawn — Environment Variables
# Copy this file to .env and fill in real values before building for production.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Open-Meteo is completely free and requires NO API key.
# No variable needed here — the base URLs are hardcoded in weather/weatherConfig.ts

# ── Google AdMob ──────────────────────────────────────────────────────────────
# Obtain from: https://admob.google.com → Apps → App settings
# Leave blank during Expo Go development — AdBanner renders a mock placeholder.
# REQUIRED for production builds — get from AdMob Console → App settings
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_APP_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# Bottom sticky banner (shown at the bottom of the Home screen)
ADMOB_BANNER_BOTTOM_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_BOTTOM_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Inline banner (shown between the decision card and weather summary)
ADMOB_BANNER_INLINE_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
ADMOB_BANNER_INLINE_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# ── RevenueCat ────────────────────────────────────────────────────────────────
# Obtain from: https://app.revenuecat.com → Project → API keys
# Leave blank during Expo Go development — premium status is mocked locally.
REVENUECAT_API_KEY_ANDROID=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
REVENUECAT_API_KEY_IOS=appl_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
